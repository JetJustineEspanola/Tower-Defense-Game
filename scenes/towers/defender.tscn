[gd_scene format=3]
[ext_resource type="PackedScene" path="res://scenes/towers/character_anime_style.tscn" id="anime_style"]
[ext_resource type="PackedScene" path="res://scenes/towers/character_animation.tscn" id="animation_driver"]
[ext_resource type="PackedScene" path="res://assets/characters/codeborn/arjie.glb" id="character"]
[ext_resource type="Script" path="res://scripts/towers/defender.gd" id="script"]
[sub_resource type="StandardMaterial3D" id="mat"]
albedo_color = Color(0.55, 0.28, 0.95, 1)
[sub_resource type="CapsuleMesh" id="mesh"]
radius = 0.17
height = 0.55
material = SubResource("mat")
[node name="Defender" type="Node3D" groups=["defenders"]]
script = ExtResource("script")
[node name="Model" parent="." instance=ExtResource("character")]
position = Vector3(0, -0.001, 0)
scale = Vector3(0.38, 0.38, 0.38)
[node name="Health" type="Label3D" parent="."]
position = Vector3(0, 1.05, 0)
billboard = 1
font_size = 26
pixel_size = 0.004
text = "GUARD 60"
[node name="AttackTimer" type="Timer" parent="."]
wait_time = 1.0
autostart = true

[node name="AnimeStyle" parent="." instance=ExtResource("anime_style")]
[node name="CharacterAnimation" parent="." instance=ExtResource("animation_driver")]
walk_clip = &"Knight_Walk"
fixed_idle_facing = false
idle_clip = &"Knight_Idle"
action_clip = &"Knight_Attack"
[connection signal="timeout" from="AttackTimer" to="." method="_attack"]
