[gd_scene format=3]
[ext_resource type="PackedScene" path="res://scenes/towers/character_anime_style.tscn" id="anime_style"]
[ext_resource type="PackedScene" path="res://scenes/towers/effects/burning_embers.tscn" id="burn_fx"]
[ext_resource type="PackedScene" path="res://scenes/towers/character_animation.tscn" id="animation_driver"]
[ext_resource type="PackedScene" path="res://assets/characters/codeborn/ronel.glb" id="character"]
[ext_resource type="Script" path="res://scripts/towers/combat_bug.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/Bug/bug.glb" id="model"]
[node name="CombatBug" type="PathFollow3D" groups=["combat_bugs"]]
rotation_mode = 1
use_model_front = true
loop = false
script = ExtResource("script")
[node name="Model" parent="." instance=ExtResource("character")]
position = Vector3(0, -0.001, 0)
scale = Vector3(0.44, 0.44, 0.44)
[node name="Health" type="Label3D" parent="."]
position = Vector3(0, 1.05, 0)
billboard = 1
font_size = 28
pixel_size = 0.004
text = "60 / 60"
[node name="AttackTimer" type="Timer" parent="."]
wait_time = 1.0
autostart = true
[node name="BurningEmbers" parent="." instance=ExtResource("burn_fx")]
position = Vector3(0, 0.4, 0)
one_shot = false
explosiveness = 0.0
amount = 18

[node name="AnimeStyle" parent="." instance=ExtResource("anime_style")]
[node name="CharacterAnimation" parent="." instance=ExtResource("animation_driver")]
walk_clip = &"Book_Walk"
fixed_idle_facing = false
idle_clip = &"Book_Idle"
action_clip = &"Book_Attack"
[connection signal="timeout" from="AttackTimer" to="." method="_attack"]
