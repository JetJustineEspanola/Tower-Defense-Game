[gd_scene format=3]
[ext_resource type="PackedScene" path="res://scenes/UI/lan_lobby.tscn" id="base"]
[ext_resource type="Script" path="res://scripts/ui/online_lobby.gd" id="script"]
[node name="OnlineLobby" instance=ExtResource("base")]
script = ExtResource("script")
[node name="Title" parent="Header" index="1"]
text = "ONLINE LOBBY"
[node name="Subtitle" parent="Header" index="2"]
text = "CREATE A ROOM • SHARE A CODE • JOIN A FRIEND"
[node name="Title" parent="Browser/Panel/Content/Heading" index="0"]
text = "JOIN YOUR FRIEND"
[node name="Refresh" parent="Browser/Panel/Content/Heading" index="1"]
text = "⚙"
tooltip_text = "Connection settings"
[node name="Count" parent="Browser/Panel/Content" index="2"]
text = "PRIVATE TWO-PLAYER ROOMS"
[node name="Empty" parent="Browser/Panel/Content/ListArea" index="0"]
visible = false
[node name="Join" parent="Browser/Panel/Content" index="5"]
disabled = false
tooltip_text = "Join using your friend's room code"
[node name="Host" parent="Browser" index="2"]
text = "CREATE ROOM"
[node name="Connection" parent="HostRoom/Panel/Content" index="1"]
text = "ONLINE • PRIVATE ROOM"
[node name="CodeEntry" type="VBoxContainer" parent="Browser/Panel/Content/ListArea"]
anchor_right = 1.0
anchor_bottom = 1.0
alignment = 1
theme_override_constants/separation = 14
[node name="Caption" type="Label" parent="Browser/Panel/Content/ListArea/CodeEntry"]
text = "ENTER ROOM CODE"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 22
[node name="Code" type="LineEdit" parent="Browser/Panel/Content/ListArea/CodeEntry"]
custom_minimum_size = Vector2(0, 56)
placeholder_text = "Example: K7MP2A"
max_length = 12
alignment = 1
theme_override_font_sizes/font_size = 28
[node name="Help" type="Label" parent="Browser/Panel/Content/ListArea/CodeEntry"]
text = "Different networks are welcome. Both players use the same room service."
autowrap_mode = 2
horizontal_alignment = 1
[node name="Invite" type="HBoxContainer" parent="HostRoom/Panel/Content"]
theme_override_constants/separation = 16
[node name="Caption" type="Label" parent="HostRoom/Panel/Content/Invite"]
text = "ROOM CODE"
[node name="Code" type="Label" parent="HostRoom/Panel/Content/Invite"]
text = "------"
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 30
theme_override_colors/font_color = Color(0.3, 0.85, 1, 1)
[node name="Copy" type="Button" parent="HostRoom/Panel/Content/Invite"]
text = "Copy code"
[node name="ConnectionOverlay" type="ColorRect" parent="."]
visible = false
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.0, 0.015, 0.04, 0.9)
[node name="Center" type="CenterContainer" parent="ConnectionOverlay"]
anchor_right = 1.0
anchor_bottom = 1.0
[node name="Panel" type="PanelContainer" parent="ConnectionOverlay/Center"]
custom_minimum_size = Vector2(620, 0)
[node name="Content" type="VBoxContainer" parent="ConnectionOverlay/Center/Panel"]
theme_override_constants/separation = 18
[node name="Title" type="Label" parent="ConnectionOverlay/Center/Panel/Content"]
text = "CONNECTION SETTINGS"
theme_override_font_sizes/font_size = 26
[node name="Help" type="Label" parent="ConnectionOverlay/Center/Panel/Content"]
text = "Paste the room service address provided by your team.\nFor local testing: ws://127.0.0.1:8080/rooms"
[node name="Address" type="LineEdit" parent="ConnectionOverlay/Center/Panel/Content"]
placeholder_text = "wss://your-relay.onrender.com/rooms"
[node name="Apply" type="Button" parent="ConnectionOverlay/Center/Panel/Content"]
text = "Save connection"
[node name="Cancel" type="Button" parent="ConnectionOverlay/Center/Panel/Content"]
text = "Cancel"
