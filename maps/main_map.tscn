[sub_resource type="Shader" id="Shader_o3c5p"]
code = "shader_type spatial;
render_mode specular_disabled;
uniform vec4 base_color : source_color = vec4(0.5,0.7,0.3,1.0);
uniform float energy = 0.0;

#include \"res://maps/style/living_wind.gdshaderinc\"
void fragment(){ ALBEDO = base_color.rgb; ROUGHNESS = 1.0; EMISSION = base_color.rgb * energy; }
void light(){
 float ndl = max(dot(NORMAL,LIGHT),0.0) * ATTENUATION;
 float band = mix(0.30,0.68,smoothstep(0.20,0.25,ndl));
 band = mix(band,0.96,smoothstep(0.63,0.69,ndl));
 vec3 cool = mix(vec3(0.63,0.70,0.94), vec3(1.0),smoothstep(0.20,0.3,ndl));
 DIFFUSE_LIGHT += cool * band * LIGHT_COLOR / 3.14159265;
}

void vertex(){VERTEX=cb_wind(VERTEX,MODEL_MATRIX,TIME);}
"

